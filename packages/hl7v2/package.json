{
  "name": "@open-twin/hl7v2",
  "version": "0.1.0",
  "description": "HL7 v2.x pipe-delimited message to FHIR R4 converter (ORU^R01, ADT^A01/A04/A08)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "format": "biome check --write",
    "lint": "biome ci",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "hl7",
    "hl7v2",
    "fhir",
    "loinc",
    "ucum",
    "connector"
  ],
  "author": "Open Science Foundation",
  "license": "MIT",
  "dependencies": {
    "@lhncbc/ucum-lhc": "^7.1.9",
    "@open-twin/fhir-core": "workspace:*",
    "@types/fhir": "^0.0.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etzm/open-twin.git",
    "directory": "packages/hl7v2"
  },
  "homepage": "https://github.com/etzm/open-twin#readme",
  "bugs": {
    "url": "https://github.com/etzm/open-twin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
