{
  "name": "@open-twin/aggregate",
  "version": "0.1.0",
  "description": "Reconciles overlapping observations from several connectors into one bundle, selecting a source on published validation evidence",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "format": "biome check --write",
    "lint": "biome ci",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "fhir",
    "wearable",
    "multi-source",
    "provenance"
  ],
  "author": "Open Science Foundation",
  "license": "MIT",
  "dependencies": {
    "@open-twin/fhir-core": "workspace:*",
    "@types/fhir": "^0.0.44"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jest-extended": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etzm/open-twin.git",
    "directory": "packages/aggregate"
  },
  "homepage": "https://github.com/etzm/open-twin#readme",
  "bugs": {
    "url": "https://github.com/etzm/open-twin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
