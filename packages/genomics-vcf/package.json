{
  "name": "@open-twin/genomics-vcf",
  "version": "0.1.0",
  "description": "VCF 4.x simple-variant to FHIR R4 mapper, following the HL7 Genomics Reporting Implementation Guide",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "format": "biome check --write",
    "lint": "biome ci",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "vcf",
    "genomics",
    "fhir",
    "connector"
  ],
  "author": "Open Science Foundation",
  "license": "MIT",
  "dependencies": {
    "@open-twin/fhir-core": "workspace:*",
    "@types/fhir": "^0.0.44",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jest-extended": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etzm/open-twin.git",
    "directory": "packages/genomics-vcf"
  },
  "homepage": "https://github.com/etzm/open-twin#readme",
  "bugs": {
    "url": "https://github.com/etzm/open-twin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
