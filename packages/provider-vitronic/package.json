{
  "name": "@open-twin/provider-vitronic",
  "version": "0.1.0",
  "description": "Vitronic API to FHIR mapper",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api/schemas/*": {
      "types": "./dist/api/schemas/*.d.ts",
      "import": "./dist/api/schemas/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/api/schemas/*.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "format": "biome check --write",
    "lint": "biome ci",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "vitronic",
    "fhir",
    "connector"
  ],
  "author": "Open Science Foundation",
  "license": "MIT",
  "dependencies": {
    "@open-twin/fhir-core": "workspace:*",
    "@types/fhir": "^0.0.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhncbc/ucum-lhc": "^7.1.9",
    "@rollup/plugin-swc": "^0.4.1",
    "@types/node": "^20.19.43",
    "jest-extended": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etzm/open-twin.git",
    "directory": "packages/provider-vitronic"
  },
  "homepage": "https://github.com/etzm/open-twin#readme",
  "bugs": {
    "url": "https://github.com/etzm/open-twin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
