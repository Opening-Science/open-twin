{
  "name": "open-twin",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "format": "biome check --write",
    "lint": "biome ci",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "verify": "tsx verify/run-verify.ts",
    "ci:local": "tsx scripts/ci-local.ts",
    "emit-bundles": "tsx verify/emit-bundles.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lhncbc/ucum-lhc": "8.0.1",
    "@open-twin/aggregate": "workspace:*",
    "@open-twin/fhir-r4": "workspace:*",
    "tsx": "4.23.15",
    "exceljs": "4.4.0"
  }
}
