{
  "name": "open-twin",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "format": "biome check --write",
    "lint": "biome ci",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "verify": "node verify/check-terminology.mjs && node verify/check-units.mjs",
    "emit-bundles": "tsx verify/emit-bundles.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@lhncbc/ucum-lhc": "^7.1.9",
    "tsx": "^4.20.6"
  }
}
