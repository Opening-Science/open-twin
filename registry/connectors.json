{
  "$schema": "./connectors.schema.json",
  "connectors": [
    {
      "id": "oura",
      "package": "@open-twin/provider-oura",
      "name": "Oura Ring API v2",
      "version": "0.1.0",
      "kind": "api",
      "auth": "oauth2",
      "domains": ["wearable"],
      "dataTypes": [
        "daily_activity",
        "heartrate",
        "sleep",
        "daily_spo2",
        "personal_info",
        "workout",
        "daily_cardiovascular_age",
        "vO2_max",
        "daily_readiness",
        "daily_resilience",
        "daily_stress",
        "rest_mode_period",
        "ring_configuration",
        "session"
      ],
      "status": "must-have",
      "priority": 100,
      "maintainer": "github:CPD9",
      "docs": "packages/provider-oura/README.md",
      "vendorDocs": "https://developer.ouraring.com/applications",
      "fixtures": "packages/provider-oura/src/tests/fixtures",
      "fixturesProvenance": "packages/provider-oura/src/tests/fixtures/PROVENANCE.md",
      "verificationBundles": ["oura-sync", "oura-sandbox-real"]
    },
    {
      "id": "google-health",
      "package": "@open-twin/provider-google-health",
      "name": "Google Health API v4",
      "version": "0.1.0",
      "kind": "api",
      "auth": "oauth2",
      "domains": ["wearable"],
      "dataTypes": [
        "daily-heart-rate-variability",
        "daily-heart-rate-zones",
        "daily-oxygen-saturation",
        "daily-respiratory-rate",
        "daily-resting-heart-rate",
        "daily-sleep-temperature-derivations",
        "daily-vo2-max",
        "blood-glucose",
        "body-fat",
        "core-body-temperature",
        "heart-rate",
        "heart-rate-variability",
        "height",
        "oxygen-saturation",
        "respiratory-rate-sleep-summary",
        "run-vo2-max",
        "vo2-max",
        "weight",
        "active-energy-burned",
        "active-minutes",
        "active-zone-minutes",
        "activity-level",
        "altitude",
        "basal-energy-burned",
        "distance",
        "floors",
        "sedentary-period",
        "steps",
        "swim-lengths-data",
        "time-in-heart-rate-zone",
        "electrocardiogram",
        "exercise",
        "hydration-log",
        "irregular-rhythm-notification",
        "nutrition-log",
        "sleep"
      ],
      "aliases": ["fitbit"],
      "status": "must-have",
      "priority": 90,
      "maintainer": "github:CPD9",
      "docs": "packages/provider-google-health/README.md",
      "verificationBundles": ["google-health-sync"]
    },
    {
      "id": "vitronic",
      "package": "@open-twin/provider-vitronic",
      "name": "VITRONIC BodyLoop body scanner",
      "version": "0.1.0",
      "kind": "api",
      "auth": "oauth2",
      "domains": ["body-scan"],
      "dataTypes": ["angle", "distance", "marker", "axis", "cross_section", "height", "properties"],
      "status": "must-have",
      "priority": 80,
      "maintainer": "github:CPD9",
      "docs": "packages/provider-vitronic/README.md",
      "fixtures": "packages/provider-vitronic/src/tests/fixtures",
      "verificationBundles": ["vitronic-scan"]
    },
    {
      "id": "whoop",
      "package": "@open-twin/provider-whoop",
      "name": "WHOOP Developer API v2",
      "version": "0.1.0",
      "kind": "api",
      "auth": "oauth2",
      "domains": ["wearable"],
      "dataTypes": ["recovery", "cycle", "sleep"],
      "status": "nice-to-have",
      "priority": 70,
      "maintainer": "github:CPD9",
      "docs": "packages/provider-whoop/README.md",
      "vendorDocs": "https://developer.whoop.com/",
      "fixtures": "packages/provider-whoop/src/tests/fixtures",
      "verificationBundles": ["whoop-sync"]
    },
    {
      "id": "open-wearables",
      "package": "@open-twin/open-wearables",
      "name": "OpenWearables normalised schema",
      "version": "0.1.0",
      "kind": "file",
      "auth": "none",
      "domains": ["wearable"],
      "dataTypes": ["timeseries", "sleepSessions", "workouts"],
      "suffixes": [".json"],
      "mediaTypes": ["application/json"],
      "status": "nice-to-have",
      "priority": 60,
      "maintainer": "github:CPD9",
      "docs": "packages/provider-open-wearables/README.md",
      "vendorDocs": "https://github.com/the-momentum/open-wearables",
      "fixtures": "packages/provider-open-wearables/src/fixtures",
      "verificationBundles": ["open-wearables-sync"]
    },
    {
      "id": "hl7v2",
      "package": "@open-twin/hl7v2",
      "name": "HL7 v2.x ORU and ADT messages",
      "version": "0.1.0",
      "kind": "file",
      "auth": "none",
      "domains": ["clinical-record", "lab"],
      "dataTypes": ["ORU^R01", "ADT^A01", "ADT^A04", "ADT^A08"],
      "suffixes": [".hl7"],
      "mediaTypes": ["x-application/hl7-v2+er7", "text/plain"],
      "status": "nice-to-have",
      "priority": 50,
      "maintainer": "github:CPD9",
      "docs": "packages/hl7v2/README.md",
      "vendorDocs": "https://build.fhir.org/ig/HL7/v2-to-fhir/",
      "fixtures": "packages/hl7v2/src/tests/fixtures",
      "verificationBundles": ["hl7v2-oru-r01"]
    },
    {
      "id": "genomics-vcf",
      "package": "@open-twin/genomics-vcf",
      "name": "VCF variant calls (Genomics Reporting IG)",
      "version": "0.1.0",
      "kind": "file",
      "auth": "none",
      "domains": ["genomics"],
      "dataTypes": ["variant"],
      "suffixes": [".vcf", ".vcf.gz"],
      "mediaTypes": ["text/plain"],
      "status": "nice-to-have",
      "priority": 40,
      "maintainer": "github:CPD9",
      "docs": "packages/genomics-vcf/README.md",
      "vendorDocs": "http://hl7.org/fhir/uv/genomics-reporting/",
      "fixtures": "packages/genomics-vcf/src/tests/fixtures",
      "fixturesProvenance": "packages/genomics-vcf/src/tests/fixtures/PROVENANCE.md",
      "verificationBundles": ["genomics-vcf-hiseq"]
    },
    {
      "id": "anchor",
      "package": "@open-twin/provider-anchor",
      "name": "Anchor lab biomarker measurements",
      "version": "0.1.0",
      "kind": "file",
      "auth": "none",
      "domains": ["lab"],
      "dataTypes": ["measurements"],
      "suffixes": [".json"],
      "mediaTypes": ["application/json"],
      "status": "research",
      "priority": 30,
      "maintainer": "github:CPD9",
      "docs": "packages/provider-anchor/README.md",
      "fixtures": "packages/provider-anchor/src/fixtures",
      "verificationBundles": [
        "anchor-hba1c",
        "anchor-mass_concentration",
        "anchor-molar_concentration",
        "anchor-enzymatic_activity",
        "anchor-ratio_percent",
        "anchor-cell_count",
        "anchor-stool_mass_mass",
        "anchor-creatinine_normalised",
        "anchor-cycle_phase_dependent",
        "anchor-arbitrary_iu"
      ]
    },
    {
      "id": "fhir-r4",
      "package": "@open-twin/fhir-r4",
      "name": "Foreign FHIR R4 bundles",
      "version": "0.1.0",
      "kind": "file",
      "auth": "none",
      "domains": ["clinical-record", "lab", "synthetic"],
      "dataTypes": ["bundle"],
      "suffixes": [".json"],
      "mediaTypes": ["application/fhir+json", "application/json"],
      "status": "nice-to-have",
      "priority": 10,
      "maintainer": "github:CPD9",
      "docs": "packages/fhir-r4/README.md",
      "vendorDocs": "https://hl7.org/fhir/R4/bundle.html",
      "fixtures": "packages/fhir-r4/src/tests/fixtures",
      "verificationBundles": ["fhir-r4-ingest"]
    }
  ]
}
